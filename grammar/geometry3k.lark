%import common.SIGNED_NUMBER -> FLOAT

frac: "\\frac" " "? "{" " "? expr " "? "}" " "? "{" " "? expr " "? "}"
sqrt: "\\sqrt" " "? "{"? " "? expr " "? "}"?
pi: "\\pi"
div: expr " "? "/" " "? expr
add: expr " "? "+" " "? expr
sub: expr " "? "-" " "? expr
mul: expr " "? "*" " "? expr
_term: frac | sqrt | pi | div | add | sub | mul | FLOAT
expr: _term (" " _term)*

start: expr
